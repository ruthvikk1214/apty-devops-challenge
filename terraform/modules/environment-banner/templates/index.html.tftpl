<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Environment Banner</title>

    <style>
        body {
            margin: 0;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            font-family: Arial, sans-serif;
            background-color: #f5f5f5;
        }

        .banner {
            text-align: center;
            padding: 50px;
            border-radius: 10px;
            background: white;
        }

        h1 {
            font-size: 48px;
        }

        p {
            font-size: 24px;
        }
    </style>
</head>

<body>

    <div class="banner">
        <h1>APTY DEVOPS CHALLENGE</h1>

        <p>
            Environment: <strong>${environment}</strong>
        </p>
    </div>

</body>
</html>